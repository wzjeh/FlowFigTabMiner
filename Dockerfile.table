# table-service: YOLO filter + TATR + PaddleOCR + MolNexTR (CPU)
FROM python:3.10-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    libopenblas0 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-table.txt .
RUN pip install --no-cache-dir -r requirements-table.txt

COPY src/ src/
COPY keywords.yaml .
COPY config.yaml .
COPY deploy/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# HF cache for TATR model (microsoft/table-transformer-...)
ENV HF_HOME=/models/models
ENV HF_HUB_CACHE=/models/models/hub
ENV HF_HUB_OFFLINE=1
ENV TRANSFORMERS_OFFLINE=1
ENV PYTHONPATH=/app

EXPOSE 8080
ENTRYPOINT ["/entrypoint.sh"]
CMD ["uvicorn", "src.services.table_service:app", "--host", "0.0.0.0", "--port", "8080"]
