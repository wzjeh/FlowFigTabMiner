# figure-service: YOLO macro/micro + PaddleOCR + coordinate mapping (CPU)
FROM python:3.10-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    libopenblas0 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-figure.txt .
RUN pip install --no-cache-dir -r requirements-figure.txt

COPY src/ src/
COPY keywords.yaml .
COPY config.yaml .
COPY deploy/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# PaddleX model dir (GCS-mounted at /models/models/paddlex) — same as table-service
ENV PADDLE_PDX_CACHE_HOME=/models/models/paddlex
# Disable OneDNN (MKL-DNN) to avoid NotImplementedError on Cloud Run CPUs
ENV FLAGS_use_mkldnn=0
ENV FLAGS_pir_apply_mkldnn_pass=0
# Disable PaddleX network connectivity check at startup (prevents 20-min hang)
ENV DISABLE_MODEL_SOURCE_CHECK=True
ENV PADDLEPD_DISABLE_MODEL_SOURCE_CHECK=True
ENV PYTHONPATH=/app

EXPOSE 8080
ENTRYPOINT ["/entrypoint.sh"]
CMD ["uvicorn", "src.services.figure_service:app", "--host", "0.0.0.0", "--port", "8080"]
