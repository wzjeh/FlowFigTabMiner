# figure-service: YOLO macro/micro + PaddleOCR + coordinate mapping (CPU)
FROM python:3.10-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    libopenblas0 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-figure.txt .
RUN pip install --no-cache-dir -r requirements-figure.txt

COPY src/ src/
COPY keywords.yaml .
COPY config.yaml .
COPY deploy/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENV PYTHONPATH=/app

EXPOSE 8080
ENTRYPOINT ["/entrypoint.sh"]
CMD ["uvicorn", "src.services.figure_service:app", "--host", "0.0.0.0", "--port", "8080"]
