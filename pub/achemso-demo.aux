\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Kinetic analysis and structure--activity relationships for organolithium intermediates. (a)~Arrhenius plots for 14 intermediates showing decomposition rate constants across temperature ranges. (b)~Hammett plot: $E_a$ vs $\sigma $ for meta/para ArLi, with three predicted validation targets (yellow diamonds). (c)~Taft steric effect: $\log t_{1/2}$ vs $E_s$ for ortho-ester ArLi, color-coded by batch yield at $-78$~\si {\celsius }. (d)~Stability ranking at $-40$~\si {\celsius } with Yoshida reactor regime zones (flash $< 1$~s, flow $\geq 1$~s).}}{20}{figure.caption.18}\protected@file@percent }
\newlabel{fig:ml-results}{{5}{20}{Kinetic analysis and structure--activity relationships for organolithium intermediates. (a)~Arrhenius plots for 14 intermediates showing decomposition rate constants across temperature ranges. (b)~Hammett plot: $E_a$ vs $\sigma $ for meta/para ArLi, with three predicted validation targets (yellow diamonds). (c)~Taft steric effect: $\log t_{1/2}$ vs $E_s$ for ortho-ester ArLi, color-coded by batch yield at $-78$~\si {\celsius }. (d)~Stability ranking at $-40$~\si {\celsius } with Yoshida reactor regime zones (flash $< 1$~s, flow $\geq 1$~s)}{figure.caption.18}{}}
